<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<Pane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      prefHeight="500.0" prefWidth="700.0"
      fx:controller="fsiAdministration.controllers.ModifierCoursController">

    <children>
        <VBox spacing="20" alignment="TOP_CENTER" prefWidth="700" style="-fx-background-color: #f4f4f4;">
            <!-- Menu -->
            <MenuBar prefWidth="700" style="-fx-background-color: #024010;">
                <menus>
                    <Menu mnemonicParsing="false" text="Gestion cours">
                        <items>
                            <MenuItem fx:id="bListeCours" mnemonicParsing="false" onAction="#bListeCoursClick" text="Liste des cours" />
                            <MenuItem fx:id="bAjouterCours" mnemonicParsing="false" onAction="#bAjouterCoursClick" text="Ajouter un cours" />
                        </items>
                    </Menu>
                    <Menu text="Autres">
                        <items>
                            <MenuItem text="Accueil" onAction="#bAccueilClick"/>
                            <MenuItem text="Quitter" onAction="#bQuitterClick"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- Titre -->
            <Label text="MODIFICATION D'UN COURS" textFill="#024010">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>

            <!-- Logo -->
            <ImageView layoutX="10.0" layoutY="60.0" fitHeight="67.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/FSI_logo.png" />
                </image>
            </ImageView>

            <!-- Formulaire -->
            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="180"/>
                    <ColumnConstraints prefWidth="400"/>
                </columnConstraints>

                <!-- Liste des cours -->
                <Label text="Sélectionner un cours :" GridPane.rowIndex="0" GridPane.columnIndex="0" textFill="#024010"/>
                <ListView fx:id="lvCours" prefHeight="100.0" GridPane.rowIndex="0" GridPane.columnIndex="1" onMouseClicked="#handleCoursSelection"/>

                <!-- ID Cours (désactivé) -->
                <Label text="ID Cours :" GridPane.rowIndex="1" GridPane.columnIndex="0" textFill="#024010"/>
                <TextField fx:id="tfIdCours" GridPane.rowIndex="1" GridPane.columnIndex="1" disable="true"/>

                <!-- Libellé -->
                <Label text="Libellé :" GridPane.rowIndex="2" GridPane.columnIndex="0" textFill="#024010"/>
                <TextField fx:id="tfLibelleCours" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Description -->
                <Label text="Description :" GridPane.rowIndex="3" GridPane.columnIndex="0" textFill="#024010"/>
                <TextField fx:id="tfDescriptionCours" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Liste des sections -->
                <Label text="Sélectionner une section :" GridPane.rowIndex="4" GridPane.columnIndex="0" textFill="#024010"/>
                <ListView fx:id="lvSections" prefHeight="100.0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Boutons -->
            <HBox spacing="30" alignment="CENTER">
                <Button fx:id="bModifier" text="MODIFIER" textFill="#ffffff" style="-fx-background-color: #024010;" onAction="#bModifierClick" prefWidth="150"/>
                <Button fx:id="bAnnuler" text="ANNULER" textFill="#ffffff" style="-fx-background-color: #024010;" onAction="#bAnnulerClick" prefWidth="150"/>
                <Button fx:id="bRetour" text="RETOUR" textFill="#ffffff" style="-fx-background-color: #024010;" onAction="#bRetourClick" prefWidth="150"/>
            </HBox>
        </VBox>
    </children>
</Pane>
